# Files that never go into the Docker build. This keeps the build fast, and keeps
# local files (secrets, databases, caches) out of the image.
.env
.env.*
*.duckdb
*.duckdb.wal
.venv/
**/__pycache__/
**/*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
tests/
tools/
Dockerfile
.dockerignore
