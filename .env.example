# Copy this file to .env and fill in your values. Never commit .env.
# Real environment variables always win over this file.

# Your Claude API key, from the Claude Console. Needed only for the agent.
ANTHROPIC_API_KEY=

# Optional: which model the agent uses, and how hard it thinks
# (low, medium, high, xhigh or max). Empty means the defaults.
ANTHROPIC_MODEL=
AGENT_EFFORT=

# Where DuckDB keeps uploaded data. ":memory:" forgets everything on restart.
DUCKDB_PATH=:memory:

# Web pages that may call the API from a browser, separated by commas.
CORS_ORIGINS=http://localhost:3000
