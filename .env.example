# Copy this file to .env and fill in your values. Never commit .env.
# Real environment variables always win over this file.

# Your Claude API key, from the Claude Console. Needed only for the agent.
ANTHROPIC_API_KEY=

# Optional: which model the agent uses, and how hard it thinks
# (low, medium, high, xhigh or max). Empty means the defaults.
ANTHROPIC_MODEL=
AGENT_EFFORT=

# Where DuckDB keeps uploaded data. ":memory:" forgets everything on restart.
DUCKDB_PATH=:memory:

# The web UI and the API answer only to localhost, 127.0.0.1 and [::1]. To
# open the app under another name, list that name here, separated by commas:
# analyst.example. A reverse proxy must pass the Host header on unchanged (see
# SECURITY.md). Docker Compose passes this setting on to the web UI, and
# `make run` reads it for the API. For `make web-dev`, set it in your shell.
ALLOWED_HOSTS=
