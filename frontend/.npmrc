# npm settings for this project.

# Never run the install scripts of packages. An install script runs with your
# permissions the moment you install a package, which is how many supply-chain
# attacks work. None of our packages needs one. (`npm run` still works.)
ignore-scripts=true

# Refuse to install with a Node.js version that package.json does not allow.
engine-strict=true

# `npm install <package>` writes the exact version, not a range such as ^1.2.0.
save-exact=true

# Keep the output short.
fund=false
